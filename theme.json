{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"layout": {
			"contentSize": "34rem",
			"wideSize": "49.5rem"
		},
		"blocks": {
			"core/image": {
				"lightbox": {
					"enabled": true,
					"allowEditing": true
				}
			}
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "\"Helvetica Neue\", Helvetica, Arial, sans-serif"
		}
	}
}
